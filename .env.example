# Copy to .env and replace the placeholder values.
# Only OPENTOPO_API_KEY is required for downloading DEM data from OpenTopography.
OPENTOPO_API_KEY=your-opentopography-api-key

# Optional overrides for bathymetry defaults.
DEM_TYPE=SRTM15Plus
MAX_PIXELS=8000000

# Optional: force headless plotting defaults for CLI runs.
# MPLBACKEND=Agg
